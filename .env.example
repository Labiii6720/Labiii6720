# --- JARVIS: Konfiguration ---
# Einfacher: npm run setup  (fragt jeden Wert ab, erzeugt Tokens, prüft sofort)
# Von Hand:  cp .env.example .env   (die .env nie committen)
# Kommentare immer auf eine eigene Zeile schreiben.

NAME=Labinot
# Anrede und Form: wie im Film «Sir» und Sie; JARVIS_FORM=du schaltet auf Duzen
JARVIS_ANREDE=Sir
JARVIS_FORM=sie
PORT=3000

# Claude: API-Key aus der Claude Console. Modell optional, Standard ist claude-sonnet-5-5
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# Starkes Modell für «!»-Nachrichten und /vorgang, Standard claude-opus-5-5 (Ausnahmen: claude-fable-5-1)
CLAUDE_MODEL_STARK=
# Werkzeugrunden pro Anfrage, normal und stark
MAX_LOOPS=10
MAX_LOOPS_STARK=40

# Alexa: Skill-ID aus der Developer Console (beginnt mit amzn1.ask.skill.)
ALEXA_SKILL_ID=
# Optional: andere Stimme, z. B. Hans. Erst im Simulator testen, leer = Alexa-Stimme
ALEXA_VOICE=

# WHOOP: Client-ID und Secret aus dem WHOOP Developer Dashboard
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Wetter-Standort in Dezimalgrad (Voreinstellung: ungefähr Muttenz, anpassen)
LAT=47.52
LON=7.65

# Google Kalender privat (Dienstkonto wie in Etappe 1)
GOOGLE_KEY_FILE=
GOOGLE_CALENDAR_ID=

# Outlook Arbeit: veröffentlichter ICS-Link. ERST NACH FREIGABE DURCH EURE IT EINTRAGEN.
OUTLOOK_ICS_URL=
# busy = Claude sieht nur belegte Zeiten (empfohlen), details = auch Titel und Orte
OUTLOOK_MODE=busy

# Ab dieser Uhrzeit bereitet Jarvis das Tagesbriefing im Hintergrund vor
BRIEFING_PREP_FROM=05:45

# Telegram: Token von @BotFather, deine Chat-ID (nur dieser Chat darf Jarvis steuern)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Etappe 3: interaktiver Jarvis ---
# PIN für sensible Aufträge (Preise, Schlösser)
JARVIS_PIN=
# Arbeitsordner für Code und Websites
JARVIS_WORKSPACE=workspace
# freigabe = jeder Shell-Befehl braucht dein OK, auto = läuft direkt
JARVIS_COMMANDS=freigabe
# Websuche über die Claude-API: on oder off
WEB_SEARCH=on

# Gmail (OAuth-Client vom Typ Desktop-App, dann npm run google:auth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Shopify (Custom App im Shop-Admin)
SHOPIFY_SHOP=
SHOPIFY_TOKEN=
SHOPIFY_API_VERSION=2026-01

# Home Assistant (langlebiger Zugriffstoken)
HA_URL=
HA_TOKEN=
HA_AUTO_DOMAINS=light,switch,media_player,fan,scene,climate

# --- Etappe 4: Browser, Stimme, Zeitpläne ---
# Pfad zu Chromium, leer = automatisch suchen
BROWSER_PATH=
# Wie lange Alexa auf eine Antwort wartet (ms), danach Weiterarbeit mit Ergebnis per Telegram
ALEXA_BUDGET_MS=6500
# Spracherkennung und Sprachausgabe, OpenAI-kompatibel (OpenAI oder lokaler Server)
STT_URL=
STT_KEY=
STT_MODEL=whisper-1
TTS_URL=
TTS_KEY=
TTS_MODEL=tts-1
TTS_VOICE=onyx

# --- Etappe 5: Ereignisse aus dem Haus ---
# Geheimnis für POST /events (z. B. openssl rand -hex 24); leer = Endpunkt aus
JARVIS_EVENT_TOKEN=
# 127.0.0.1 = nur lokal, 0.0.0.0 = im Heimnetz erreichbar (für Home Assistant auf einem anderen Gerät)
LISTEN_HOST=127.0.0.1
# /events und /gesture auch über den Cloudflare Tunnel erlauben: off (Standard) oder on
EVENTS_VIA_TUNNEL=off

# --- Etappe 7: Kameras ---
# Frigate NVR
FRIGATE_URL=
# MQTT-Broker für Live-Meldungen von Frigate (optional, sonst über Home Assistant)
MQTT_URL=
MQTT_USER=
MQTT_PASSWORD=
# Home-Assistant-Entität für «zu Hause», z. B. person.labinot (für Meldungen nur wenn abwesend)
HA_PRESENCE_ENTITY=

# --- Etappe 10: Finanzen, Berater, Notfall ---
# Ton des Beraters: sanft, direkt oder hart
BERATER_TON=direkt
# Zahlungen nur vorbereiten, nie auslösen: on (empfohlen) oder off
ZAHLUNG_NUR_VORBEREITEN=on
# Panik-Auslöser für POST /notfall (z. B. openssl rand -hex 24); leer = Endpunkt aus
JARVIS_PANIC_TOKEN=

# --- Kommandozentrale und Werkstatt ---
# Dashboard unter /dashboard (nur Heimnetz/Tailscale, nutzt JARVIS_EVENT_TOKEN): on (Standard) oder off
DASHBOARD=on
# OpenSCAD für die Werkstatt (3D-Teile entwerfen und rendern); leer = automatisch suchen
OPENSCAD_PATH=
# 3D-Drucker über OctoPrint (optional)
OCTOPRINT_URL=
OCTOPRINT_KEY=

# --- Etappe 12: Proaktivität und Sparsamkeit ---
# Günstiges Modell für Hintergrundarbeit (Kamera-Wachen, kurze Blicke)
CLAUDE_MODEL_SEHEN=claude-haiku-4-5-20251001
# Tages-/Abendrückblick (Lernen aus dem Tag), HH:MM oder off
RUECKBLICK=22:30
# Rechnungs-Erinnerung täglich HH:MM (off = aus) und Vorlauf in Tagen
RECHNUNG_ERINNERUNG=08:30
RECHNUNG_VORLAUF_TAGE=3
# Wöchentlicher Zielcheck: Wochentag und Uhrzeit (so mo di mi do fr sa), oder off
ZIELCHECK=so 18:00
